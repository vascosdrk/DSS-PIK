# ==============================================================================
# DSS-PIK BMKG Kepulauan Riau — PRODUCTION ENVIRONMENT TEMPLATE (Split Compose)
# Copy to `.env.production` (`chmod 600 .env.production`) on Ubuntu Server.
# NEVER commit `.env.production` or real credentials to Git.
# ==============================================================================

# Explicit Release Image Version (NEVER rely solely on `latest` in production)
DSS_PIK_VERSION=1.1.0

# Frontend Nginx Ingress (Default: loopback-only behind host Nginx/Caddy HTTPS proxy)
DSS_PIK_BIND_IP=127.0.0.1
DSS_PIK_HTTP_PORT=8080

# Host path to canonical operational data directory (mounted read-only)
DSS_PIK_DATA_DIR=/srv/dss-pik/data

# MariaDB Production Database (Internal Docker Network `mariadb:3306`)
CEWS_DB_NAME=cews_db
CEWS_DB_USER=dsspik_prod
CEWS_DB_PASSWORD=GENERATE_STRONG_UNIQUE_APP_PASSWORD_32_CHARS
MARIADB_ROOT_PASSWORD=GENERATE_STRONG_UNIQUE_ROOT_PASSWORD_32_CHARS

# Production Security & Trusted Internal Proxy CIDR
CEWS_DOCKER_LOCAL_ONLY=false
CEWS_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Application Authentication (Operator Login — set unique credentials directly on server)
# Backend hashes DSS_PIK_PASSWORD once with bcrypt in memory at startup.
# (Legacy DSS_PIK_PASSWORD_HASH remains supported as temporary fallback if DSS_PIK_PASSWORD is unset.)
DSS_PIK_USERNAME=your_admin_username
DSS_PIK_PASSWORD=your_own_strong_password

# Generate 64-char hex session secret:
#   openssl rand -hex 32
DSS_PIK_SESSION_SECRET=generate_unique_random_secret
