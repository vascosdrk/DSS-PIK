# ==============================================================================
# DSS-PIK BMKG Kepulauan Riau — Split 3-Container Environment Template
# Copy to `.env` (or `.env.production` on server, chmod 600), NEVER commit secrets!
# Generate all production passwords, bcrypt hash & session secret directly on server.
# ==============================================================================

# Image release tag (never rely solely on `latest` in production)
DSS_PIK_VERSION=1.1.0

# Frontend Nginx ingress binding (default: loopback-only behind host TLS proxy)
DSS_PIK_BIND_IP=127.0.0.1
DSS_PIK_HTTP_PORT=8080

# Host path to canonical operational data directory (mounted read-only into backend)
DSS_PIK_DATA_DIR=./data

# MariaDB Database (Internal Docker Network `mariadb:3306`, never exposed publicly)
CEWS_DB_NAME=cews_db
CEWS_DB_USER=dsspik_app
CEWS_DB_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_APP_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_ROOT_PASSWORD

# Security & Trusted Internal Reverse Proxy
# Keep CEWS_DOCKER_LOCAL_ONLY=false in production
CEWS_DOCKER_LOCAL_ONLY=false
CEWS_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Operator Authentication (generate bcrypt hash & 64-char hex secret on target server)
# Wrap bcrypt hash in single quotes '...' so Docker Compose does not interpolate '$'
DSS_PIK_USERNAME=klimatkepri
DSS_PIK_PASSWORD_HASH='$2b$12$REPLACE_WITH_GENERATED_BCRYPT_HASH_ON_SERVER'
DSS_PIK_SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET
