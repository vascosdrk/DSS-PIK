# ==============================================================================
# DSS-PIK Docker Environment Template (.env.docker.example)
# Copy to `.env.docker` (git-ignored) and fill in real values before running:
#   docker compose --env-file .env.docker up -d
# ==============================================================================

# Image Version Tag (never rely solely on `latest` in staging/production)
DSS_PIK_VERSION=0.8.0-dev

# Isolated Local Host Port (18000 avoids conflict with native DSS-PIK on 8000)
DSS_PIK_HOST_PORT=18000
# Allow ONLY the single dynamically detected Docker bridge host gateway (host port bound to 127.0.0.1)
CEWS_DOCKER_LOCAL_ONLY=true

# MariaDB Configuration (internal Docker network `mariadb:3306`)
CEWS_DB_NAME=cews_db_migration_test
CEWS_DB_USER=dsspik_app
CEWS_DB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Optional: Path to initial SQL dump for first-time empty-volume seeding
# MIGRATION_SQL_SEED_PATH=F:/TNJ/paper/DSS_PIK_MIGRATION_EXPORT/DSS_PIK_BACKUPS/backup_20261122_131441/cews_db_20261122_131441.sql

# DSS-PIK Application Authentication (copy bcrypt hash & 64-char secret from secure store)
DSS_PIK_USERNAME=klimatkepri
DSS_PIK_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
DSS_PIK_SESSION_SECRET=CHANGE_ME_64_HEX_SESSION_SECRET
